print("SCHOOL STATIONERY SHOP SYSTEM")

import mysql.connector
from datetime import datetime
from decimal import Decimal

try:
    mydb = mysql.connector.connect(
        host="localhost",
        user="root",
        password="12345678"
    )

    mycursor = mydb.cursor()

    mycursor.execute("CREATE DATABASE IF NOT EXISTS stationary_shop")
    mycursor.execute("USE stationary_shop")

    mycursor.execute("""
    CREATE TABLE IF NOT EXISTS items (
        item_id VARCHAR(10) NOT NULL PRIMARY KEY,
        item_name VARCHAR(50) NOT NULL,
        category VARCHAR(30) NOT NULL,
        price DECIMAL(6,2) NOT NULL,
        stock_quantity INT NOT NULL
    )
    """)

    mycursor.execute("""
    CREATE TABLE IF NOT EXISTS purchases (
        purchase_id VARCHAR(30) NOT NULL PRIMARY KEY,
        student_name VARCHAR(30) NOT NULL,
        student_class VARCHAR(10) NOT NULL,
        item_name VARCHAR(50) NOT NULL,
        quantity INT NOT NULL,
        unit_price DECIMAL(6,2) NOT NULL,
        total_amount DECIMAL(8,2) NOT NULL,
        purchase_date DATE NOT NULL
    )
    """)

    mycursor.execute("""
    ALTER TABLE purchases
    MODIFY purchase_id VARCHAR(30) NOT NULL
    """)

    mydb.commit()
    print("Database and tables created successfully!")

except mysql.connector.Error as e:
    print("Database connection error:", e)
    exit()


while True:
    print("\n1 - Add Stationery Items")
    print("2 - View Available Stock")
    print("3 - Purchase Items")
    print("4 - View Purchase History")
    print("5 - Update Item Details")
    print("6 - Delete Items")
    print("7 - Update Stock Quantity")
    print("8 - View Daily Sales Report")
    print("9 - Exit")

    try:
        ch = int(input("Enter your choice: "))
    except ValueError:
        print("Please enter a valid number!")
        continue

    if ch == 1:
        try:
            print("ADD STATIONERY ITEMS")

            item_id = input("Enter Item ID: ")
            item_name = input("Enter Item Name: ")
            category = input("Enter Category (Pen/Pencil/Book/Paper/Other): ")
            price = Decimal(input("Enter Price per item: "))
            stock_quantity = int(input("Enter Stock Quantity: "))

            if price <= 0 or stock_quantity < 0:
                print("Invalid price or stock quantity!")
                continue

            mycursor.execute(
                "INSERT INTO items VALUES (%s,%s,%s,%s,%s)",
                (item_id, item_name, category, price, stock_quantity)
            )

            mydb.commit()
            print("Stationery item added successfully!")

        except mysql.connector.IntegrityError:
            print("Item ID already exists!")

        except Exception as e:
            print("Error:", e)

    elif ch == 2:
        mycursor.execute(
            "SELECT * FROM items WHERE stock_quantity > 0 ORDER BY category"
        )
        items = mycursor.fetchall()

        if items:
            print("\nAVAILABLE STATIONERY ITEMS")
            print("ID | Item Name | Category | Price | Stock")
            print("-" * 60)

            for item in items:
                print(item[0], "|", item[1], "|", item[2],
                      "| Rs.", item[3], "|", item[4])
        else:
            print("No items in stock!")

    elif ch == 3:
        try:
            print("PURCHASE ITEMS")

            student_name = input("Enter Student Name: ")
            student_class = input("Enter Class: ")

            mycursor.execute(
                "SELECT * FROM items WHERE stock_quantity > 0"
            )
            available_items = mycursor.fetchall()

            if available_items:
                print("\nAVAILABLE ITEMS")

                for item in available_items:
                    print(item[0], "-", item[1], "Rs.",
                          item[3], "- Stock:", item[4])

                item_id = input("Enter Item ID to purchase: ")
                quantity = int(input("Enter Quantity: "))

                if quantity <= 0:
                    print("Quantity must be greater than zero!")
                    continue

                mycursor.execute(
                    "SELECT item_name, price, stock_quantity FROM items WHERE item_id=%s",
                    (item_id,)
                )

                result = mycursor.fetchone()

                if result and result[2] >= quantity:
                    item_name = result[0]
                    unit_price = result[1]
                    total_amount = unit_price * quantity

                    purchase_id = "PUR" + datetime.now().strftime("%Y%m%d%H%M%S%f")

                    mycursor.execute(
                        "INSERT INTO purchases VALUES (%s,%s,%s,%s,%s,%s,%s,%s)",
                        (purchase_id, student_name, student_class,
                         item_name, quantity, unit_price, total_amount,
                         datetime.now().date())
                    )

                    mycursor.execute(
                        "UPDATE items SET stock_quantity = stock_quantity - %s WHERE item_id=%s",
                        (quantity, item_id)
                    )

                    mydb.commit()

                    print("\nPURCHASE SUCCESSFUL!")
                    print("-" * 35)
                    print("Purchase ID:", purchase_id)
                    print("Student Name:", student_name)
                    print("Class:", student_class)
                    print("Item:", item_name)
                    print("Quantity:", quantity)
                    print("Unit Price: Rs.", unit_price)
                    print("Total Amount: Rs.", total_amount)
                    print("-" * 35)

                else:
                    print("Item not available or insufficient stock!")

            else:
                print("No items available for purchase!")

        except Exception as e:
            mydb.rollback()
            print("Error:", e)

    elif ch == 4:
        mycursor.execute(
            "SELECT * FROM purchases ORDER BY purchase_date DESC"
        )

        purchases = mycursor.fetchall()

        if purchases:
            print("\nPURCHASE HISTORY")
            print("Purchase ID | Student | Class | Item | Qty | Price | Total | Date")
            print("-" * 100)

            for purchase in purchases:
                print(purchase[0], "|", purchase[1], "|",
                      purchase[2], "|", purchase[3], "|",
                      purchase[4], "|", "Rs." + str(purchase[5]),
                      "|", "Rs." + str(purchase[6]), "|", purchase[7])

        else:
            print("No purchase history found!")

    elif ch == 5:
        try:
            print("UPDATE ITEM DETAILS")

            mycursor.execute("SELECT * FROM items ORDER BY item_name")
            items = mycursor.fetchall()

            if items:
                print("CURRENT ITEMS:")

                for item in items:
                    print(item[0], "-", item[1], "-", item[2],
                          "- Rs.", item[3], "- Stock:", item[4])

                item_id = input("Enter Item ID to update: ")

                mycursor.execute(
                    "SELECT * FROM items WHERE item_id=%s",
                    (item_id,)
                )

                result = mycursor.fetchone()

                if result:
                    print("Current Details:", result[1], "-", result[2],
                          "- Rs.", result[3], "Stock:", result[4])

                    new_name = input(
                        "Enter New Item Name (or press Enter to keep current): "
                    ) or result[1]

                    new_category = input(
                        "Enter New Category (or press Enter to keep current): "
                    ) or result[2]

                    new_price = input(
                        "Enter New Price (or press Enter to keep current): "
                    )

                    if new_price:
                        new_price = Decimal(new_price)

                        if new_price <= 0:
                            print("Price must be greater than zero!")
                            continue
                    else:
                        new_price = result[3]

                    mycursor.execute(
                        "UPDATE items SET item_name=%s, category=%s, price=%s WHERE item_id=%s",
                        (new_name, new_category, new_price, item_id)
                    )

                    mydb.commit()
                    print("Item details updated successfully!")

                else:
                    print("Item not found!")

            else:
                print("No items found to update!")

        except Exception as e:
            print("Error:", e)

    elif ch == 6:
        print("DELETE ITEMS")

        mycursor.execute("SELECT * FROM items ORDER BY item_name")
        items = mycursor.fetchall()

        if items:
            print("CURRENT ITEMS:")

            for item in items:
                print(item[0], "-", item[1], "-", item[2],
                      "- Rs.", item[3], "- Stock:", item[4])

            item_id = input("Enter Item ID to delete: ")

            mycursor.execute(
                "SELECT * FROM items WHERE item_id=%s",
                (item_id,)
            )

            result = mycursor.fetchone()

            if result:
                print("Item to delete:", result[1], "-", result[2],
                      "- Rs.", result[3])

                if result[4] > 0:
                    print("Cannot delete! Stock is still available.")

                else:
                    confirm = input(
                        "Are you sure you want to delete this item? (yes/no): "
                    )

                    if confirm.lower() == 'yes':
                        mycursor.execute(
                            "DELETE FROM items WHERE item_id=%s",
                            (item_id,)
                        )

                        mydb.commit()
                        print("Item deleted successfully!")

                    else:
                        print("Deletion cancelled.")

            else:
                print("Item not found!")

        else:
            print("No items found to delete!")

    elif ch == 7:
        try:
            print("UPDATE STOCK QUANTITY")

            mycursor.execute("SELECT * FROM items ORDER BY item_name")
            items = mycursor.fetchall()

            if items:
                print("CURRENT STOCK:")

                for item in items:
                    print(item[0], "-", item[1],
                          "- Current Stock:", item[4])

                item_id = input("Enter Item ID to update stock: ")

                mycursor.execute(
                    "SELECT * FROM items WHERE item_id=%s",
                    (item_id,)
                )

                result = mycursor.fetchone()

                if result:
                    print("Current Stock for", result[1], ":", result[4])

                    new_stock = int(input("Enter New Stock Quantity: "))

                    if new_stock < 0:
                        print("Stock cannot be negative!")
                        continue

                    mycursor.execute(
                        "UPDATE items SET stock_quantity=%s WHERE item_id=%s",
                        (new_stock, item_id)
                    )

                    mydb.commit()
                    print("Stock updated successfully!")

                else:
                    print("Item not found!")

            else:
                print("No items found to update!")

        except Exception as e:
            print("Error:", e)

    elif ch == 8:
        try:
            date = input(
                "Enter Date (YYYY-MM-DD) or press Enter for today: "
            )

            if date:
                date = datetime.strptime(date, "%Y-%m-%d").date()
            else:
                date = datetime.now().date()

            mycursor.execute(
                "SELECT COUNT(*), SUM(total_amount) FROM purchases WHERE purchase_date=%s",
                (date,)
            )

            result = mycursor.fetchone()

            if result[0] > 0:
                print("\nDAILY SALES REPORT FOR", date)
                print("Total Purchases:", result[0])
                print("Total Revenue: Rs.", result[1])

                mycursor.execute(
                    "SELECT item_name, SUM(quantity), SUM(total_amount) "
                    "FROM purchases WHERE purchase_date=%s GROUP BY item_name",
                    (date,)
                )

                item_sales = mycursor.fetchall()

                print("\nITEM-WISE SALES:")

                for sale in item_sales:
                    print(sale[0], "- Sold:", sale[1],
                          "- Revenue: Rs.", sale[2])

                print("\nLOW STOCK ALERT (Less than 10 items):")

                mycursor.execute(
                    "SELECT item_name, stock_quantity FROM items WHERE stock_quantity < 10"
                )

                low_stock = mycursor.fetchall()

                if low_stock:
                    for item in low_stock:
                        print("WARNING:", item[0], "- Only",
                              item[1], "left in stock!")
                else:
                    print("All items have sufficient stock.")

            else:
                print("No sales found for this date!")

        except ValueError:
            print("Invalid date! Please use YYYY-MM-DD format.")

        except Exception as e:
            print("Error:", e)

    elif ch == 9:
        print("Thank you for using School Stationery Shop System!")
        break

    else:
        print("Invalid choice! Please select 1-9.")


mycursor.close()
mydb.close()
print("MySQL connection closed.")
